  "narrative": {
    "overview": "This documents the current provisional implementation of the requested clean, professional, uncluttered website. Detailed UI direction remains deferred; this is an implementation reference, not a new brand identity. The source of truth is `app/globals.css` and the rendered React components.\n\nThe page uses generous open space, navy text, restrained blue-purple accents and a single sans-serif family. Typographic hierarchy and fine horizontal rules organise content. English and German share the same visual system and accommodate their different text lengths.",
    "keyCharacteristics": [
      "Light backgrounds and readable text.",
      "Spacious sections with clear headings.",
      "Restrained accent colour and simple link actions."
    ],
